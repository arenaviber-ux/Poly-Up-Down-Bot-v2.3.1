# ─────────────────────────────────────────────────────────────────────────────
# Poly Up/Down Bot — configuration template
#
#   cp .env.example .env      then edit the REQUIRED block below
#
# Everything here is optional except the five values in the REQUIRED block.
# Every unset variable falls back to the default shown in the comment, so an
# empty .env runs the bot in paper mode against live market data.
#
# NEVER commit your .env — it holds a private key.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════
# 1. REQUIRED — wallet + credentials
# ═══════════════════════════════════════════════════════════════════════════

# Private key of the SIGNER — the key that signs orders and relayer batches.
#   • Polymarket web account (email/Google/Magic): profile → Export Private Key
#   • A wallet you connected to Polymarket: that wallet's key
# 0x prefix optional.
POLY_PRIVATE_KEY=

# The ACCOUNT WALLET (a.k.a. Deposit Wallet / proxy / Safe) — the address that
# actually holds your pUSD and your positions. Copy it from the polymarket.com
# profile menu. It is NOT your signer address.
# Required for POLY_SIGNATURE_TYPE 1, 2 and 3 (i.e. everyone but a plain EOA).
POLY_FUNDER_ADDRESS=

# Which kind of account wallet POLY_FUNDER_ADDRESS is:
#   0 = EOA              (funder == signer; leave POLY_FUNDER_ADDRESS empty)
#   1 = POLY_PROXY       (legacy Magic-Link / email / Google accounts)
#   2 = GNOSIS_SAFE      (legacy accounts created by connecting MetaMask/Rabby)
#   3 = DEPOSIT_WALLET   (POLY_1271 — every account created after 2026-05-04)
# Wrong value ⇒ orders fail with "maker address not allowed" or a balance of 0.
POLY_SIGNATURE_TYPE=3

# Relayer API key — authorises the GASLESS on-chain calls the bot needs:
# the trading approvals (`npm run approve`) and the redemption sweep.
# Create it at polymarket.com → Settings → API Keys → Relayer API Keys, and copy
# BOTH values it shows ("API Key" and "Signer Address").
# Without these the bot cannot approve the exchanges and cannot redeem wins.
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# CLOB trading credentials. Leave EMPTY and the bot derives them from
# POLY_PRIVATE_KEY on start-up (POST /auth/api-key, falling back to
# GET /auth/derive-api-key). Only fill these in if you have an existing key.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=


# ═══════════════════════════════════════════════════════════════════════════
# 2. Live vs paper
# ═══════════════════════════════════════════════════════════════════════════

# true  = simulated fills, no money moves (the default — start here)
# false = real orders on Polymarket
PAPER_MODE=true

# Sign orders but never POST them. Useful for one more dry run in live mode.
#DRY_RUN_ORDERS=false

# Refuse to trade when the geoblock check says this region is restricted.
#REQUIRE_GEOBLOCK_PASS=true

# Grant the four exchange approvals automatically at start-up if any are
# missing (gasless relayer batch). Set false to be prompted to run
# `npm run approve` yourself instead.
#AUTO_APPROVE=true


# ═══════════════════════════════════════════════════════════════════════════
# 3. Market selection & order sizing
# ═══════════════════════════════════════════════════════════════════════════

#ASSET=btc                 # btc | eth | sol | ...
#ASSET_SYMBOL=btcusd       # PolyBolt symbol, lowercase
#TIMEFRAMES=5m             # 5m,15m or all
#LOOKAHEAD_WINDOWS=2

# TRADE_SIZE_USD, MAX_TRADE_SIZE_USD and KELLY_SIZING: a value set in this file wins over
# the dashboard's saved value on every restart. The saved value applies only where this
# file leaves the key unset. The start-up banner shows where each value came from.
#TRADE_SIZE_USD=10.0
#MIN_TRADE_SIZE_USD=1.0
# Hard cap on what ONE order can cost, taker fee included (shares x limit price + fee).
# If the market's minimum share count costs more than this, the trade is declined, even with
# MIN_ORDER_POLICY=bump.
#MAX_TRADE_SIZE_USD=25.0
#MIN_ORDER_SHARES=5        # fallback only: used when the order book does not report the market's minimum
#DEFAULT_TICK_SIZE=0.01
#MIN_ORDER_POLICY=bump     # bump = raise the stake to the minimum, skip = don't trade
#MAX_SLIPPAGE_CENTS=2
#MAX_BUY_PRICE=0.97
#ORDER_TYPE=FAK            # FAK | FOK | GTC | GTD
#GTD_SECONDS=30           # signed expiry floored at 210s; local cancel timeout unchanged
#KELLY_SIZING=false
#KELLY_FRACTION=0.25

# Fees (crypto markets publish rate 0.07 / exponent 1; these are the fallbacks)
#DEFAULT_TAKER_FEE_RATE=0.07
#MAX_TAKER_FEE_RATE=0.10
#MIN_NET_EDGE=0.015


# ═══════════════════════════════════════════════════════════════════════════
# 4. Risk
# ═══════════════════════════════════════════════════════════════════════════

#STOP_LOSS_USD=25.0
#TAKE_PROFIT_USD=0         # 0 = disabled
#MAX_DAILY_LOSS_USD=50
#MAX_OPEN_POSITIONS=1
#MAX_TRADES_PER_WINDOW=1
#COOLDOWN_SECONDS=20
#MAX_SPREAD_CENTS=6
#MIN_BOOK_DEPTH_USD=100
#MIN_SECONDS_TO_EXPIRY=10  # account-wide floor; strategy floors are clamped to it
#ORDER_TIMEOUT_SECONDS=12


# ═══════════════════════════════════════════════════════════════════════════
# 5. Capital recycling — the pre-expiry exit and the redemption sweeper
# ═══════════════════════════════════════════════════════════════════════════

#EXIT_ENABLED=true
#EXIT_MAX_SECONDS_TO_EXPIRY=45
#EXIT_MIN_SECONDS_TO_EXPIRY=10
#EXIT_MIN_MODEL_PROB=0.97
#EXIT_MIN_SELL_PRICE=0.93
#EXIT_MAX_SELL_PRICE=0.995
#EXIT_MAX_BID_DEPTH_PARTICIPATION=0.25
#EXIT_MIN_PROFIT_FLOOR_USD=0
#EXIT_MIN_NET_EDGE=0
#EXIT_ORDER_TYPE=FAK
#EXIT_MAX_ATTEMPTS=3
#EXIT_RETRY_COOLDOWN_SECONDS=3

#AUTO_REDEEM=true
#AUTO_REDEEM_EVERY_MS=300000
#REDEEM_OUTPUT_TOKEN=pUSD  # pUSD (V2 adapter) | usdce (legacy)
#REDEEM_VERIFY_ONCHAIN=true
#REDEEM_MIN_VALUE_USD=0
#REDEEM_MAX_PER_RUN=25
#REDEEM_POLL_MAX=20
#REDEEM_POLL_MS=2000


