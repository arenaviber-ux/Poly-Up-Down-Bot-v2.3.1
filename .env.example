#SQS_MIN_EDGE=0.01
#SQS_MIN_LEFT=8

# ---------------------------------------------------------------------------
# 9. Passive Reversion — the only module that does not TAKE liquidity.
#
# The eight modules above all buy at the ask and pay Polymarket's crypto taker
# fee: 0.07 x p x (1-p), up to 1.75c/share at 50c. Makers are never charged a
# fee on Polymarket (and 20% of the taker fees collected in a market are
# redistributed daily to that market's makers), so this module rests a
# post-only bid instead of crossing the spread.
#
# It fires when the book has swung below the TWAP model's fair value — common
# since the TWAP upgrade, because the book reacts to spot far harder than the
# 60s Chainlink TWAP that actually settles the window. It is also the only
# edge here that is not a latency race: a resting bid fills because it is the
# best price, not because it got there first.
#
# NOTE: ORDER_TYPE does not apply to this module. It always submits GTD +
# postOnly, because a FAK "resting" order cancels itself the instant it lands.
# MR_REST_SECONDS is a local cancellation deadline, NOT the signed expiry.
# GTD expiry is at least 210s ahead (180s CLOB minimum + 30s transit margin).
# If the bot stops or cancellation fails, the quote can rest until that expiry.
# While a quote rests it counts as an open position, so with
# MAX_OPEN_POSITIONS=1 nothing else trades in that window for up to
# MR_REST_SECONDS.
# ---------------------------------------------------------------------------
#ENABLE_STRAT_MAKER_REVERSION=true
#MR_MIN_EDGE=0.015          # net edge required at the quote. Fee-free, so this
                            # is pure buffer against adverse selection: it is
                            # what you get paid for being picked off sometimes.
#MR_MIN_PROB=0.55           # don't quote a side the model isn't already on
#MR_MAX_QUOTE_PRICE=0.85    # above this a fill is nearly always toxic
#MR_IMPROVE_TICKS=1         # 1 = top of book; 0 = join the best bid
#MR_MAX_TICKS_BELOW_BID=2   # stand down if our best price is further below the
                            # market than this (it would never fill)
#MR_MIN_DISLOCATION=0.02    # how far below fair the bid must be before we quote
#MR_MIN_BID_DEPTH=150       # real resting liquidity beneath the quote
#MR_REST_SECONDS=20         # how long a quote may sit on the book
#MR_CANCEL_BUFFER=8         # leave this much room to cancel before the floor
#MR_POST_ONLY=true          # false lets a quote cross and pay the taker fee
#MR_MIN_LEFT=45             # closest to expiry it will place a quote
#MR_MAX_LEFT=240            # furthest from expiry it will place a quote


# ═══════════════════════════════════════════════════════════════════════════
# 7. Reference prices (the TWAP the markets settle against)
# ═══════════════════════════════════════════════════════════════════════════

#REFERENCE_SOURCE=auto     # auto | polybolt | spot
#TWAP_WINDOW_SECONDS=60
#MIN_VOL_PER_SEC=0.02
#WINDOW_OPEN_GRACE_SECONDS=30
#VOL_LOOKBACK_SECONDS=300
#COINBASE_PRODUCT=BTC-USD
#KRAKEN_PAIR=XBT/USD


# ═══════════════════════════════════════════════════════════════════════════
# 8. Endpoints & runtime — only override these if something moves
# ═══════════════════════════════════════════════════════════════════════════

#CHAIN_ID=137
#CLOB_URL=https://clob.polymarket.com
#GAMMA_URL=https://gamma-api.polymarket.com
#DATA_API_URL=https://data-api.polymarket.com
#MARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
#USER_WS=wss://ws-subscriptions-clob.polymarket.com/ws/user
#POLYBOLT_WS=wss://ws-live-v2.polymarket.com/ws
#GEOBLOCK_URL=https://polymarket.com/api/geoblock
#RELAYER_URL=https://relayer-v2.polymarket.com
# Public Polygon RPC. polygon-rpc.com returns 401 to anonymous callers, which
# silently breaks the on-chain balance/approval reads — use a real endpoint.
#POLYGON_RPC=https://polygon-bor-rpc.publicnode.com

#PORT=3000
#BIND_HOST=127.0.0.1       # 0.0.0.0 to expose the dashboard on your network
#DASHBOARD_ORIGIN=         # CORS allow-origin for the dashboard
#LOOP_MS=750
#DISCOVERY_MS=10000
#MAX_BOOK_AGE_MS=5000
#STATE_FILE=bot_state.json
#LOG_LEVEL=INFO

# Builder attribution (optional). A Builder key can stand in for a Relayer key
# for the gasless calls; the builder fields go on the order itself.
#POLY_BUILDER_API_KEY=
#POLY_BUILDER_SECRET=
#POLY_BUILDER_PASSPHRASE=

# Relayer tuning
#RELAYER_DEADLINE_SECONDS=300
#RELAYER_PROXY_GAS_LIMIT=10000000
